<ResourceDictionary
    x:Class="PlanAstro.NINA.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="PlanAstroBoolToVisibility" />

    <!-- NINA shows this template on the plugin's page. The key must be the plugin name followed by _Options. -->
    <DataTemplate x:Key="PlanAstro for NINA_Options">
        <StackPanel Margin="0,0,0,12" Orientation="Vertical">

            <!-- Connection -->
            <TextBlock Margin="0,0,0,6" FontSize="16" FontWeight="SemiBold" Text="Connection" />
            <TextBlock Margin="0,0,0,8" Text="{Binding Status}" TextWrapping="Wrap" />

            <StackPanel Visibility="{Binding IsNotPaired, Converter={StaticResource PlanAstroBoolToVisibility}}">
                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="In PlanAstro, open Menu &gt; Connect NINA, then type the 6-character code here." />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="140" Margin="0,0,8,0" MaxLength="6" CharacterCasing="Upper"
                             Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pairing code from PlanAstro" />
                    <Button Width="100" Command="{Binding PairCommand}" Content="Pair" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsPaired, Converter={StaticResource PlanAstroBoolToVisibility}}">
                <Button Width="120" Margin="0,0,8,0" Command="{Binding CheckNowCommand}" Content="Check now" />
                <Button Width="120" Command="{Binding DisconnectCommand}" Content="Disconnect" />
            </StackPanel>

            <!-- Settings -->
            <TextBlock Margin="0,18,0,6" FontSize="16" FontWeight="SemiBold" Text="Settings" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="This PC's name in PlanAstro" />
                <TextBox Grid.Row="0" Grid.Column="1" Width="220" Margin="0,4" HorizontalAlignment="Left" Text="{Binding DeviceName}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Check every (seconds)" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="80" Margin="0,4" HorizontalAlignment="Left" Text="{Binding PollSeconds}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="When a target arrives" />
                <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,4" VerticalAlignment="Center"
                          Content="Open it in the Framing Assistant" IsChecked="{Binding OpenNewArrivals}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="PlanAstro address" />
                <TextBox Grid.Row="3" Grid.Column="1" Width="320" Margin="0,4" HorizontalAlignment="Left"
                         Text="{Binding BaseUrl}" ToolTip="Leave as https://planastro.com unless testing a preview build" />
            </Grid>

            <!-- Inbox -->
            <DockPanel Margin="0,18,0,6" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="SemiBold" Text="PlanAstro inbox" />
                <Button DockPanel.Dock="Right" Width="160" Command="{Binding AddTestTargetCommand}" Content="Add test target (M31)" />
            </DockPanel>
            <TextBlock Margin="0,0,0,6" Opacity="0.7" Text="Targets sent from PlanAstro, newest first." />

            <ItemsControl ItemsSource="{Binding Inbox}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="10" BorderBrush="Gray" BorderThickness="1" CornerRadius="6">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Width="190" Margin="8,0,8,0" Content="Open in Framing Assistant"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Width="80" Content="Dismiss"
                                            Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Opacity="0.8" Text="{Binding Summary}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.8" Text="{Binding Rig.Telescope}" />
                                    <TextBlock Opacity="0.8" Text="{Binding Note}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.6" Text="{Binding SentAtLocal}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
